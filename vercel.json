{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/allincenter-pelecard",
      "destination": "/allincenter-pelecard/index.html"
    },
    {
      "source": "/((?!api/|allincenter-pelecard(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
