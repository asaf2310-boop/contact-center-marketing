{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/pelecard",
      "destination": "/allincenter-pelecard",
      "permanent": true
    },
    {
      "source": "/pelecard/",
      "destination": "/allincenter-pelecard",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/whatsapp",
      "destination": "https://app.allincenter.co.il/whatsapp"
    },
    {
      "source": "/whatsapp/:path*",
      "destination": "https://app.allincenter.co.il/whatsapp/:path*"
    },
    {
      "source": "/api/public/whatsapp-landing",
      "destination": "https://app.allincenter.co.il/api/public/whatsapp-landing"
    },
    {
      "source": "/api/public/whatsapp-consent/:path*",
      "destination": "https://app.allincenter.co.il/api/public/whatsapp-consent/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://app.allincenter.co.il/brand/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://app.allincenter.co.il/_next/:path*"
    },
    {
      "source": "/lp",
      "destination": "/lp/index.html"
    },
    {
      "source": "/lp/",
      "destination": "/lp/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/pricing/",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/ai",
      "destination": "/ai/index.html"
    },
    {
      "source": "/ai/",
      "destination": "/ai/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/about/",
      "destination": "/about/index.html"
    },
    {
      "source": "/systems",
      "destination": "/systems/index.html"
    },
    {
      "source": "/systems/",
      "destination": "/systems/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/",
      "destination": "/services/index.html"
    },
    {
      "source": "/appointment-management",
      "destination": "/appointment-management/index.html"
    },
    {
      "source": "/appointment-management/",
      "destination": "/appointment-management/index.html"
    },
    {
      "source": "/restaurant-reservations",
      "destination": "/restaurant-reservations/index.html"
    },
    {
      "source": "/restaurant-reservations/",
      "destination": "/restaurant-reservations/index.html"
    },
    {
      "source": "/allincenter-pelecard",
      "destination": "/allincenter-pelecard/index.html"
    },
    {
      "source": "/allincenter-pelecard/",
      "destination": "/allincenter-pelecard/index.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/guides/",
      "destination": "/guides/index.html"
    },
    {
      "source": "/guides/how-to-choose-appointment-system",
      "destination": "/guides/how-to-choose-appointment-system/index.html"
    },
    {
      "source": "/guides/how-to-choose-appointment-system/",
      "destination": "/guides/how-to-choose-appointment-system/index.html"
    },
    {
      "source": "/guides/restaurant-reservation-system",
      "destination": "/guides/restaurant-reservation-system/index.html"
    },
    {
      "source": "/guides/restaurant-reservation-system/",
      "destination": "/guides/restaurant-reservation-system/index.html"
    },
    {
      "source": "/guides/ai-automation-small-business",
      "destination": "/guides/ai-automation-small-business/index.html"
    },
    {
      "source": "/guides/ai-automation-small-business/",
      "destination": "/guides/ai-automation-small-business/index.html"
    },
    {
      "source": "/guides/seo-ai-visibility-business",
      "destination": "/guides/seo-ai-visibility-business/index.html"
    },
    {
      "source": "/guides/seo-ai-visibility-business/",
      "destination": "/guides/seo-ai-visibility-business/index.html"
    },
    {
      "source": "/google-ai-visibility",
      "destination": "/google-ai-visibility/index.html"
    },
    {
      "source": "/google-ai-visibility/",
      "destination": "/google-ai-visibility/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
