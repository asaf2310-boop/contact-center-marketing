# דמו מוקד (smart-break-shift)
VITE_CONTACT_CENTER_DEMO_URL=https://smart-break-shift-demo.vercel.app
# תאימות לאחור:
# VITE_PRODUCT_URL=https://smart-break-shift-demo.vercel.app

# דמו Maya Clinic — קביעת תורים וניהול לקוחות
VITE_MAYACLINIC_DEMO_URL=https://mayaclinic-demo.vercel.app

# יצירת קשר
VITE_CONTACT_URL=mailto:demo@example.com?subject=בקשת הדגמה לפתרון דיגיטלי לעסק
# סנכרון מאובטח למערכת הלידים (צד שרת בלבד)
LEAD_INGEST_URL=https://allincenter-scanner.vercel.app/api/leads/ingest
LEAD_INGEST_SECRET=generate-the-same-long-random-secret-as-lead-scanner

# —— AllInCenter / הסכמים ——
VITE_AGREEMENT_PROVIDER_NAME=AllInCenter
VITE_AGREEMENT_PROVIDER_PHONE=0540000000
VITE_AGREEMENT_PROVIDER_PHONE_DISPLAY=054-000-0000
VITE_AGREEMENT_PROVIDER_EMAIL=info@allincenter.co.il

# מפתח ניהול לאזור אדמין (גם בצד שרת: AGREEMENT_ADMIN_KEY)
VITE_AGREEMENT_ADMIN_KEY=your-secret-admin-key
AGREEMENT_ADMIN_KEY=your-secret-admin-key
AGREEMENT_ADMIN_EMAIL=info@allincenter.co.il

# כתובת האתר לקישורי חתימה (אופציונלי — מזוהה אוטומטית ב-Vercel)
PUBLIC_APP_URL=https://your-domain.vercel.app
# VITE_PUBLIC_APP_URL=https://your-domain.vercel.app

# ביט — קישור מלא (מומלץ) או טלפון לבניית קישור אוטומטי
# דוגמה: https://www.bitpay.co.il/app/pay?phone=972540000000&amount=250
VITE_BIT_PAYMENT_URL=
VITE_BIT_PHONE=0540000000
# VITE_BIT_QR_IMAGE=/payment/bit-qr.png

# Supabase — שמירת הסכמים (הריצו supabase/digital_agreements.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# ב-Vercel בלבד (ל-API):
SUPABASE_SERVICE_ROLE_KEY=

# SMTP — שליחת מיילים עם PDF מצורף
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=AllInCenter <info@allincenter.co.il>

# מצב דמו מקומי בלי DB
# VITE_DEMO_MODE=true
